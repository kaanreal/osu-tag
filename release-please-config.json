{
    "primary-branch": "main",
    "tag-separator": "",
    "include-component-in-tag": false,
    "pull-request-title-pattern": "chore: release ${version}",
    "packages": {
        ".": {
            "release-type": "simple",
            "package-name": "osu!tag",
            "version-file": "src/OsuTag/version.txt",
            "changelog-sections": [
                { "type": "feat", "section": "✨ New Features" },
                { "type": "fix", "section": "🛠 Improvements" },
                { "type": "perf", "section": "🛠 Improvements" },
                { "type": "bug", "section": "🐞 Bug Fixes" },
                { "type": "chore", "section": "🔧 Under the Hood" }
            ]
        }
    },
    "header": "Thank you for using **osu!tag**! 🚀",
    "footer": "---\nDownload the new version and enjoy a smoother experience."
}
