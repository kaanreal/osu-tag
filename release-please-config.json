{
    "packages": {
        ".": {
            "release-type": "simple",
            "package-name": "",
            "changelog-path": "CHANGELOG.md",
            "bump-minor-pre-major": true,
            "bump-patch-for-minor-pre-major": true,
            "draft": false,
            "prerelease": false,
            "extra-files": [
                {
                    "type": "xml",
                    "path": "src/osu!tag/Osutag.csproj",
                    "xpath": "//Version"
                },
                {
                    "type": "xml",
                    "path": "src/osu!tag/Info.plist",
                    "xpath": "//plist/dict/string[preceding-sibling::key[1]='CFBundleVersion' or preceding-sibling::key[1]='CFBundleShortVersionString']"
                },
                {
                    "type": "generic",
                    "path": "src/osu!tag/version.txt"
                }
            ]
        }
    },
    "changelog-sections": [
        { "type": "feat", "section": "✨ New Features", "hidden": false },
        { "type": "fix", "section": "🐞 Bug Fixes", "hidden": false },
        { "type": "perf", "section": "🛠 Improvements", "hidden": false },
        { "type": "refactor", "section": "🔧 Under the Hood", "hidden": false },
        { "type": "chore", "section": "🔧 Under the Hood", "hidden": false }
    ]
}
