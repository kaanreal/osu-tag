{
    "primary-branch": "main",
    "tag-separator": "",
    "include-component-in-tag": false,
    "pull-request-title-pattern": "chore: release ${version}",
    "pull-request-header": "",
    "packages": {
        ".": {
            "release-type": "simple",
            "package-name": "osu!tag",
            "version-file": "src/OsuTag/version.txt",
            "changelog-template": ".github/template.hbs",
            "changelog-sections": [
                { "type": "feat", "section": "✨ New Features", "hidden": false },
                { "type": "fix", "section": "🛠 Improvements", "hidden": false },
                { "type": "perf", "section": "🛠 Improvements", "hidden": false },
                { "type": "bug", "section": "🐞 Bug Fixes", "hidden": false },
                { "type": "chore", "section": "🔧 Under the Hood", "hidden": false }
            ]
        }
    }
}
