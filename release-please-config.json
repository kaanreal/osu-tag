{
    "primary-branch": "main",
    "tag-separator": "",
    "include-component-in-tag": false,
    "pull-request-title-pattern": "v.${version}",
    "packages": {
        ".": {
            "release-type": "simple",
            "package-name": "osu!tag",
            "version-file": "src/OsuTag/version.txt",
            "changelog-sections": [
                { "type": "feat", "section": "## ✨ New Features", "hidden": false },
                { "type": "fix", "section": "## 🛠 Improvements", "hidden": false },
                { "type": "perf", "section": "## 🛠 Improvements", "hidden": false },
                { "type": "bug", "section": "## 🐞 Bug Fixes", "hidden": false }
            ]
        }
    }
}
