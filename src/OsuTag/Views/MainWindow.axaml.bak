<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OsuTag.ViewModels"
        xmlns:converters="using:OsuTag.Converters"
        x:Class="OsuTag.Views.MainWindow"
        Title="osu!tag"
        Width="1400" Height="900"
        MinWidth="1200" MinHeight="700"
        Background="#0A0E14"
        Foreground="#E6E6E8"
        WindowStartupLocation="CenterScreen">
    
    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="72,*">
        <!-- Header -->
        <Border Grid.Row="0" Margin="0" Classes="AnimatedOpacity">
            <Border.Background>
                 <SolidColorBrush Color="{StaticResource SurfaceElevatedColor}" Opacity="0.95"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" Opacity="0.15" OffsetY="4"/>
            </Border.Effect>
            
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="osu!tag Beatmap Converter" 
                               FontSize="19" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Convert beatmaps to Spotify-ready MP3s" 
                               FontSize="11" 
                               Foreground="{StaticResource TextTertiaryBrush}" 
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Select All" 
                            Classes="Secondary" 
                            Command="{Binding SelectAllCommand}" 
                            Margin="0,0,8,0"/>
                    <Button Content="Deselect All" 
                            Classes="Secondary" 
                            Command="{Binding DeselectAllCommand}" 
                            Margin="0,0,16,0"/>
                    <Button Content="⚙ Settings" 
                            Classes="Secondary" 
                            Command="{Binding SettingsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

         <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="*,380">
            <!-- Content Placeholder (Replacing original simple grid) -->
            <!-- Left Column: Map List -->
            <Grid Grid.Column="0" Margin="32,24,12,0" RowDefinitions="Auto,*">
                
                <!-- Search Section -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Search Box -->
                    <TextBox Classes="Modern" 
                             Text="{Binding SearchQuery, Mode=TwoWay}"
                             Watermark="Search maps by title, artist, or creator..."
                             Grid.Column="0">
                        <TextBox.InnerLeftContent>
                            <TextBlock Text="🔍" 
                                       VerticalAlignment="Center" 
                                       Margin="12,0,4,0" 
                                       FontSize="14" 
                                       Foreground="{StaticResource TextTertiaryBrush}"/>
                        </TextBox.InnerLeftContent>
                    </TextBox>

                    <!-- Results Count -->
                    <Border Grid.Column="1" 
                            Background="{StaticResource SurfaceElevatedBrush}" 
                            CornerRadius="8" 
                            Padding="16,0" 
                            Margin="12,0,0,0"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                             <TextBlock Text="{Binding FilteredMaps.Count}" 
                                        FontWeight="SemiBold" 
                                        Foreground="{StaticResource AccentBrush}"/>
                             <TextBlock Text=" maps" 
                                        Foreground="{StaticResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Map List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,16,24">
                    <StackPanel>
                        <!-- Loader -->
                        <StackPanel IsVisible="{Binding IsScanning}" 
                                    HorizontalAlignment="Center" 
                                    Margin="0,40">
                             <ProgressBar IsIndeterminate="True" 
                                          Width="40" Height="40" 
                                          Foreground="{StaticResource AccentBrush}"
                                          Background="Transparent"/>
                             <TextBlock Text="{Binding ScanStatusMessage}" 
                                        HorizontalAlignment="Center" 
                                        Margin="0,16,0,0" 
                                        Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Maps -->
                        <ItemsControl ItemsSource="{Binding FilteredMaps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="200" ItemHeight="280"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="180" Height="260" Margin="0,0,20,20" CornerRadius="4" Background="White"
                                            BoxShadow="0 2 8 0 #1A000000">
                                         <!-- Interaction Triggers via Styles -->
                                         <Border.Styles>
                                             <Style Selector="Border">
                                                 <Setter Property="RenderTransform" Value="scale(1)"/>
                                                 <Setter Property="Transitions">
                                                     <Transitions>
                                                         <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="QuadraticEaseOut"/>
                                                         <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.1"/>
                                                     </Transitions>
                                                 </Setter>
                                             </Style>
                                             <Style Selector="Border:pointerover">
                                                 <Setter Property="RenderTransform" Value="scale(1.02) rotate(1deg)"/>
                                                 <Setter Property="BoxShadow" Value="0 8 16 0 #2E000000"/>
                                                 <Setter Property="ZIndex" Value="1"/>
                                             </Style>
                                         </Border.Styles>

                                        <Grid RowDefinitions="*,Auto">
                                            <!-- Cover Image -->
                                            <Border Grid.Row="0" Margin="6,6,6,0" Background="#F0F0F0" ClipToBounds="True">
                                                <Image Source="{Binding CoverPath}" Stretch="UniformToFill"/>
                                            </Border>

                                            <!-- Info Section -->
                                            <StackPanel Grid.Row="1" Margin="10,8,10,12">
                                                <TextBlock Text="{Binding Title}" 
                                                           Foreground="#333" FontWeight="SemiBold" FontSize="12" 
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Artist}" 
                                                           Foreground="{StaticResource AccentBrush}" FontSize="12" 
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Creator, StringFormat='mapped by {0}'}" 
                                                           Foreground="#999" FontSize="10" 
                                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <!-- Selected Overlay -->
                                            <Border Grid.Row="0" Grid.RowSpan="2" 
                                                    CornerRadius="4" 
                                                    Background="{StaticResource AccentBrush}"
                                                    Opacity="0.9"
                                                    IsVisible="{Binding IsSelected}">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="✓" FontSize="32" Foreground="White" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="SELECTED" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Click Area -->
                                            <Button Grid.Row="0" Grid.RowSpan="2" 
                                                    Background="Transparent" 
                                                    Command="{Binding ((vm:MainViewModel)DataContext).ToggleMapSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <Button.Styles>
                                                    <Style Selector="Button">
                                                        <Setter Property="Template">
                                                            <ControlTemplate>
                                                                <Panel Background="Transparent"/>
                                                            </ControlTemplate>
                                                        </Setter>
                                                    </Style>
                                                </Button.Styles>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Load More Button -->
                        <Button Content="Load More Maps" 
                                Classes="Secondary"
                                HorizontalAlignment="Center" 
                                Margin="0,16"
                                Command="{Binding LoadMoreCommand}"
                                IsVisible="{Binding CanLoadMore}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <!-- Left Column: Map List (Selection Panel Upgrade) -->
            <!-- Adding Selection Panel Floating at Bottom of Left Column -->
             <Border Grid.Column="0" 
                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,24"
                    Background="{StaticResource SurfaceElevatedBrush}"
                    CornerRadius="12"
                    BoxShadow="0 8 32 0 #4D000000"
                    IsVisible="{Binding SelectedCount}">
                <Grid RowDefinitions="Auto,Auto" Width="400">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="16,12">
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="12" Padding="10,4">
                            <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="12">
                                <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                                <Run Text=" selected"/>
                            </TextBlock>
                        </Border>
                        
                        <Button Grid.Column="2" Content="Clear All" 
                                Classes="Secondary" Padding="8,4" FontSize="11"
                                Command="{Binding DeselectAllCommand}"/>
                    </Grid>
                    
                    <!-- Expanded List (Simplified for now) -->
                    <ScrollViewer Grid.Row="1" MaxHeight="200" Margin="16,0,16,12" 
                                  IsVisible="{Binding IsSelectionPanelExpanded}">
                         <ItemsControl ItemsSource="{Binding SelectedItems}">
                             <ItemsControl.ItemTemplate>
                                 <DataTemplate>
                                     <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                         <Grid ColumnDefinitions="*,Auto">
                                             <TextBlock Text="{Binding DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             <Button Grid.Column="1" Content="✕" FontSize="10" Padding="4,2" Classes="Secondary"
                                                     Command="{Binding ((vm:MainViewModel)DataContext).ToggleMapSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     CommandParameter="{Binding}"/>
                                         </Grid>
                                     </Border>
                                 </DataTemplate>
                             </ItemsControl.ItemTemplate>
                         </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Column: Sidebar -->
            <Grid Grid.Column="1" Margin="20,28,32,32" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
                
                <!-- Input Path -->
                <Border Grid.Row="0" Classes="AnimatedOpacity"
                        Background="{StaticResource SurfaceElevatedBrush}" 
                        CornerRadius="12" Padding="20" Margin="0,0,0,20"
                        BoxShadow="0 4 16 0 #1A000000">
                     <StackPanel>
                         <TextBlock Text="osu! Songs Path" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,12"/>
                         <Grid ColumnDefinitions="*,Auto">
                             <TextBox Grid.Column="0" Classes="Modern" Text="{Binding SelectedPath}" IsReadOnly="True" Margin="0,0,8,0"/>
                             <Button Grid.Column="1" Content="📁" Classes="Secondary" Command="{Binding BrowseCommand}" Padding="10" ToolTip.Tip="Browse"/>
                         </Grid>
                         <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                             <Button Grid.Column="0" Content="Use Default" Classes="Secondary" Command="{Binding UseDefaultPathCommand}" Margin="0,0,4,0" FontSize="11"/>
                             <Button Grid.Column="1" Content="Rescan" Classes="Secondary" Command="{Binding RescanCommand}" Margin="4,0,0,0" FontSize="11"/>
                         </Grid>
                     </StackPanel>
                </Border>

                <!-- Convert Button -->
                <Button Grid.Row="1" 
                        Content="Convert to MP3" 
                        Classes="Primary"
                        Command="{Binding StartConversionCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,20"
                        IsEnabled="{Binding CanConvert}"/>
                
                <!-- Status -->
                <Border Grid.Row="2" Classes="AnimatedOpacity"
                        Background="{StaticResource SurfaceElevatedBrush}" 
                        CornerRadius="12" Padding="20" Margin="0,0,0,20"
                        BoxShadow="0 4 16 0 #1A000000">
                     <StackPanel>
                         <TextBlock Text="Status" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,12"/>
                         <TextBlock Text="{Binding PathStatusMessage}" FontSize="13" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"/>
                         <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="#FF6B6B" TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="{Binding ErrorMessage, Converter={StaticResource NullToBoolConverter}}"/>
                     </StackPanel>
                </Border>

                <!-- Output Path -->
                <Border Grid.Row="3" Classes="AnimatedOpacity"
                        Background="{StaticResource SurfaceElevatedBrush}" 
                        CornerRadius="12" Padding="20" Margin="0,0,0,20"
                        BoxShadow="0 4 16 0 #1A000000">
                     <StackPanel>
                         <TextBlock Text="Output Path" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,12"/>
                         <Grid ColumnDefinitions="*,Auto">
                             <TextBox Grid.Column="0" Classes="Modern" Text="{Binding OutputPath}" Margin="0,0,8,0"/>
                             <Button Grid.Column="1" Content="📁" Classes="Secondary" Command="{Binding BrowseOutputPathCommand}" Padding="10"/>
                         </Grid>
                     </StackPanel>
                </Border>

                <!-- Progress -->
                <Border Grid.Row="4" Classes="AnimatedOpacity"
                        Background="{StaticResource SurfaceElevatedBrush}" 
                        CornerRadius="12" Padding="20" Margin="0,0,0,20"
                        BoxShadow="0 4 16 0 #1A000000"
                        IsVisible="{Binding IsProcessing}">
                     <StackPanel>
                         <TextBlock Text="Progress" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,12"/>
                         <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="6" Margin="0,0,0,12" Foreground="{StaticResource AccentBrush}"/>
                         <TextBlock Text="{Binding ProgressMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                     </StackPanel>
                </Border>

                <!-- Results -->
                <Border Grid.Row="5" Classes="AnimatedOpacity"
                        Background="{StaticResource SurfaceElevatedBrush}" 
                        CornerRadius="12" Padding="20"
                        BoxShadow="0 4 16 0 #1A000000">
                     <Grid RowDefinitions="Auto,*">
                         <TextBlock Grid.Row="0" Text="Results" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,12"/>
                         <ScrollViewer Grid.Row="1">
                             <ItemsControl ItemsSource="{Binding ConversionResults}">
                                 <ItemsControl.ItemTemplate>
                                     <DataTemplate>
                                         <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                             <StackPanel>
                                                 <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                                                 <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                             </StackPanel>
                                         </Border>
                                     </DataTemplate>
                                 </ItemsControl.ItemTemplate>
                             </ItemsControl>
                         </ScrollViewer>
                     </Grid>
                </Border>

                <!-- Footer -->
                <StackPanel Grid.Row="6" HorizontalAlignment="Center" Margin="0,20">
                    <TextBlock Text="osu!tag v1.0.0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="by Kaan and AI" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4"/>
                    <Button Content="☕ Buy me a coffee" Classes="Secondary" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0" Padding="12,6"/>
                </StackPanel>

            </Grid>
        </Grid>
    </Grid>
</Window>
