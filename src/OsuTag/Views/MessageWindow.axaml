<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OsuTag.Views.MessageWindow"
        Title="Message"
        Width="400" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="#1C212B"
        TransparencyLevelHint="None">
    
    <Border BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Background="#1C212B">
        <Grid RowDefinitions="Auto,*,Auto">
             <!-- Header -->
             <TextBlock Name="TitleText" Text="Title" Margin="24,24,24,12" FontWeight="Bold" FontSize="18" Foreground="#E6EDF3"/>
             
             <!-- Content -->
             <TextBlock Name="MessageText" Text="Message Content" Margin="24,0,24,24" TextWrapping="Wrap" Grid.Row="1" Foreground="#8B949E" FontSize="14"/>
             
             <!-- Footer -->
             <Border Grid.Row="2" Padding="24" Background="#0D1117" CornerRadius="0,0,8,8" BorderBrush="#30363D" BorderThickness="0,1,0,0">
                 <Button Content="OK" HorizontalAlignment="Right" Click="Ok_Click" Background="#238636" Foreground="White" Width="80" HorizontalContentAlignment="Center"/>
             </Border>
        </Grid>
    </Border>
</Window>
