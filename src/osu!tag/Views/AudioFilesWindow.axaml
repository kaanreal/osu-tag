<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:Osutag.Converters"
        x:Class="Osutag.Views.AudioFilesWindow"
        Title="Select Audio File"
        Width="460" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        CanResize="False"
        PointerPressed="OnPointerPressed">
    
    <Grid RowDefinitions="Auto,*,Auto" Classes="WindowEntrance" Margin="32">
        <StackPanel Spacing="12">
            <TextBlock Text="Select Audio File" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="This beatmap has multiple audio files. Select which one to use."
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="13"/>
        </StackPanel>
        
        <ScrollViewer Grid.Row="1" Margin="0,24">
            <ItemsControl x:Name="AudioFilesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8" Margin="0,0,0,8" Padding="16,12" Cursor="Hand"
                                PointerPressed="AudioItem_Click"
                                PointerEntered="AudioItem_PointerEntered"
                                PointerExited="AudioItem_PointerExited"
                                BoxShadow="0 2 8 0 #0D000000"
                                Classes.selected="{Binding IsSelected}">
                             <Border.Styles>
                                 <Style Selector="Border">
                                     <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
                                     <Setter Property="BorderThickness" Value="1"/>
                                     <Setter Property="BorderBrush" Value="Transparent"/>
                                     <Setter Property="Transitions">
                                         <Transitions>
                                             <BrushTransition Property="Background" Duration="0:0:0.1"/>
                                         </Transitions>
                                     </Setter>
                                 </Style>
                                 <Style Selector="Border:pointerover">
                                     <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                 </Style>
                                 <Style Selector="Border.selected">
                                     <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                                     <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                 </Style>
                             </Border.Styles>

                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="🎵" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" FontWeight="Medium"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <Button Content="Cancel" Click="Cancel_Click"
                    Classes="Secondary" Padding="24,10"/>
            <Button Content="Confirm Selection" Click="OK_Click"
                    Classes="Primary" Padding="24,10"/>
        </StackPanel>
    </Grid>
</Window>
