<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Osutag.ViewModels"
        xmlns:converters="using:Osutag.Converters"
        xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        xmlns:services="using:Osutag.Services"
        x:Class="Osutag.Views.MainWindow"
        xmlns:cc="using:Osutag.Controls"
        Title="osu!tag"
        Width="1400" Height="900"
        MinWidth="1200" MinHeight="700"
        Background="#E6121620"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        PointerPressed="OnPointerPressed">
    
    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <converters:BoolToDoubleConverter x:Key="BoolToDoubleConverter"/>
        <converters:BoolToTransformConverter x:Key="BoolToTransformConverter"/>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
        <converters:BoolNegationConverter x:Key="BoolNegationConverter"/>
    </Window.Resources>


    <Window.Styles>
        <Style Selector="Grid#RootGrid">
            <!-- Animation handled in code-behind -->
        </Style>


        <Style Selector="Panel#MainOverlay">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:1.0" Easing="QuinticEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Panel#MainOverlay[Opacity=0]">
        </Style>

        <Style Selector="Panel.LoadingEntrance">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.8" Easing="QuinticEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.8" Easing="QuinticEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Grid.WindowEntrance">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:1.0" Easing="QuinticEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:1.0" Easing="QuinticEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Grid.WindowEntrance[Opacity=0]">
            <Setter Property="RenderTransform" Value="translateY(30px)"/>
        </Style>

        <Style Selector="Border.BrandingIcon">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:1.0" Easing="QuinticEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.8" Easing="QuinticEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBlock.BrandingText">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:1.0" Easing="QuinticEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.8" Easing="QuinticEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ProgressBar.SmoothLoader">
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*" Name="RootGrid">
        <!-- Custom Title Bar (Always reserves space, buttons visible only on Windows) -->
        <Panel Grid.Row="0" IsHitTestVisible="True" Height="32" Background="Transparent">
             <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsWindows}">
                <!-- Spacing for title bar buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
                    <Button Width="46" Height="32" Classes="TitleBarButton" Click="Minimize_Click" ToolTip.Tip="Minimize">
                        <Path Data="M 0 0 L 10 0" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="46" Height="32" Classes="TitleBarButton" Click="Maximize_Click" ToolTip.Tip="Maximize/Restore">
                        <Path Data="M 0 0 L 10 0 L 10 10 L 0 10 Z" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="46" Height="32" Classes="TitleBarButton Close" Click="Close_Click" ToolTip.Tip="Close">
                        <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
             </Grid>
        </Panel>

        <Grid Grid.Row="1" RowDefinitions="80,*">
        <!-- Premium Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceElevatedBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Classes="AnimatedOpacity"
                BoxShadow="0 4 20 0 #1A000000">
            
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
 
                <!-- Left: App Branding -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Width="40" Height="40" Background="{DynamicResource AccentBrush}" 
                            CornerRadius="10" Margin="0,0,16,0">
                        <Image Source="/Assets/app.ico" Width="28" Height="28" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="osu!tag" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AppVersion}" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="8" Opacity="0.6" OffsetX="0" OffsetY="0"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            
                            <!-- Update Badge -->
                            <Button IsVisible="{Binding IsUpdateAvailable}" 
                                    Command="{Binding OpenUpdateWindowCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="0" Margin="4,0,0,3" VerticalAlignment="Bottom" Cursor="Hand">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </Button.Styles>
                                <TextBlock Text="{Binding NewUpdateVersion}" FontSize="11" FontWeight="Bold" Foreground="#52C565">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#52C565" BlurRadius="6" Opacity="0.4"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Button>

                            <!-- GitHub Link (Pill Shape) -->
                            <!-- GitHub Link (Pill Badge) -->
                            <Border BorderBrush="White" 
                                    BorderThickness="1.2" 
                                    CornerRadius="14" 
                                    Background="Black"
                                    Margin="12,0,0,1" 
                                    VerticalAlignment="Bottom"
                                    BoxShadow="0 1 4 0 #40000000">
                                <Button Command="{Binding OpenGithubCommand}" 
                                        Background="Transparent" 
                                        BorderThickness="0"
                                        CornerRadius="14"
                                        Padding="8,3" 
                                        Cursor="Hand">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="#1A1A1A"/>
                                            <Setter Property="BorderBrush" Value="White"/>
                                        </Style>
                                    </Button.Styles>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                            <Path Data="M12 2A10 10 0 0 0 2 12C2 16.42 4.87 20.17 8.84 21.5C9.34 21.58 9.5 21.27 9.5 21.03C9.5 20.82 9.5 20.24 9.5 19.5C6.71 20.11 6.12 18.15 6.12 18.15C5.67 16.97 5.03 16.66 5.03 16.66C4.12 16.03 5.1 16.05 5.1 16.05C6.1 16.12 6.63 17.08 6.63 17.08C7.5 18.61 8.96 18.17 9.54 17.91C9.62 17.27 9.87 16.84 10.15 16.59C7.92 16.34 5.58 15.47 5.58 11.63C5.58 10.53 5.97 9.63 6.61 8.92C6.5 8.67 6.16 7.64 6.71 6.27C6.71 6.27 7.56 6 9.5 7.31C10.3 7.09 11.15 6.98 12 6.97C12.85 6.98 13.7 7.09 14.5 7.31C16.44 6 17.29 6.27 17.29 6.27C17.84 7.64 17.5 8.67 17.39 8.92C18.04 9.63 18.42 10.53 18.42 11.63C18.42 15.48 16.07 16.34 13.84 16.59C14.2 16.9 14.5 17.53 14.5 18.48C14.5 19.86 14.5,20.97 14.5,21.03C14.5,21.27 14.66,21.59 15.17,21.5C19.14,20.16 22,16.42 22,12A10 10 0 0 0 12 2Z" 
                                                  Fill="White"/>
                                        </Viewbox>
                                        <TextBlock Text="{Binding GithubStars}" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="by Kaan and AI" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                    </StackPanel>
                </StackPanel>
 
                <!-- Right: Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <Button Classes="HeaderButton" Command="{Binding OpenSupporterUrlCommand}" 
                            Padding="12,8" BorderBrush="#FF57A0" BorderThickness="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="❤️" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="buy me osu! supporter" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Select All" Classes="HeaderButton" Command="{Binding SelectAllCommand}"/>
                    <Button Content="Deselect All" Classes="HeaderButton" Command="{Binding DeselectAllCommand}"/>
                    <Button Content="⚙" FontSize="18" Padding="12,8" Classes="HeaderButton" Command="{Binding SettingsCommand}" ToolTip.Tip="Settings"/>
                </StackPanel>
            </Grid>
        </Border>

         <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="*" ClipToBounds="False" Classes="WindowEntrance"
              Opacity="{Binding IsInitialLoadDone, Converter={StaticResource BoolToDoubleConverter}}">





            <Grid Grid.Column="0" Margin="32,24,32,12" RowDefinitions="Auto,*" ClipToBounds="False">
                
                <!-- Top Section: Path & Search -->
                <StackPanel Grid.Row="0" Spacing="24" Margin="0,0,0,24">
                    <!-- osu! Songs Path -->
                    <Border Background="{StaticResource SurfaceElevatedBrush}" 
                            CornerRadius="16" Padding="20" 
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <PathIcon Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" 
                                      Foreground="{StaticResource AccentBrush}" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="osu! Songs Path" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}"/>
                                <TextBlock Text="{Binding SelectedPath}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button Content="Use Default" Classes="Secondary" Command="{Binding UseDefaultPathCommand}"/>
                                <Button Content="Browse" Classes="Secondary" Command="{Binding BrowseCommand}"/>
                                <Button Content="Rescan" Classes="Primary" Padding="16,8" Command="{Binding RescanCommand}" ToolTip.Tip="Rescan"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                     <!-- Search Section -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <Border CornerRadius="8" Name="SearchBorder">
                                <Border.Styles>
                                    <Style Selector="Border#SearchBorder">
                                        <Setter Property="Transitions">
                                            <Transitions>
                                                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                            </Transitions>
                                        </Setter>
                                        <Setter Property="BoxShadow" Value="0 4 12 0 #1A000000"/>
                                        <Setter Property="ClipToBounds" Value="False"/>
                                    </Style>
                                    <Style Selector="Border#SearchBorder:focus-within">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Animations>
                                            <Animation Duration="0:0:2" IterationCount="Infinite">
                                                <KeyFrame Cue="0%"><Setter Property="BoxShadow" Value="0 0 0 0 #005B9FED"/></KeyFrame>
                                                <KeyFrame Cue="50%"><Setter Property="BoxShadow" Value="0 0 15 2 #405B9FED"/></KeyFrame>
                                                <KeyFrame Cue="100%"><Setter Property="BoxShadow" Value="0 0 0 0 #005B9FED"/></KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </Border.Styles>
                                <Grid>
                                    <PathIcon Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                              Width="18" Height="18" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left"
                                              Margin="16,0,0,0" 
                                              Foreground="{StaticResource TextTertiaryBrush}"
                                              ZIndex="1">
                                        <PathIcon.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                                            </Transitions>
                                        </PathIcon.Transitions>
                                        <PathIcon.Styles>
                                            <Style Selector="Border#SearchBorder:focus-within PathIcon">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </Style>
                                        </PathIcon.Styles>
                                    </PathIcon>
                                    
                                    <cc:PlayfulTextBox Name="SearchTextBox"
                                             Text="{Binding SearchQuery, Mode=TwoWay}"
                                             Watermark="Search by: Artist, Title, Creator, Difficulty, Tags, or Source..."
                                             Height="50"
                                             FontSize="16"
                                             HorizontalContentAlignment="Left"
                                             VerticalContentAlignment="Center"
                                             HorizontalAlignment="Stretch"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             Margin="34,0,10,0"
                                             ClipToBounds="False"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Results Badge -->
                        <Border Grid.Column="1" 
                                Background="{StaticResource SurfaceElevatedBrush}" 
                                CornerRadius="25" 
                                Padding="20,0" 
                                Margin="16,0,0,0"
                                Height="50"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                     <PathIcon Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2v-3h2v3zm4 0h-2v-5h2v5z"
                                               Foreground="{StaticResource AccentBrush}" Width="16" Height="16" VerticalAlignment="Center"/>
                                     <TextBlock Text="{Binding FilteredMaps.Count}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                 <TextBlock Text="results" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>


                <!-- Map List (Virtualized for 240Hz Performance) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,20,16,24" ClipToBounds="True">
                    <Grid RowDefinitions="*,Auto" ClipToBounds="True">
                        <ItemsRepeater ItemsSource="{Binding MapGroups}" ClipToBounds="True">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout ItemsStretch="None" 
                                                 MinItemWidth="200" 
                                                 MinItemHeight="280" 
                                                 Orientation="Horizontal"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="180" Height="260" Margin="10,0,20,20" x:Name="MapCard" ClipToBounds="False"
                                            services:AnimationHelper.EnableEntranceAnimation="True"
                                            Background="Transparent">

                                        <!-- Main Interactive Wrapper utilizing Button for correct Input handling -->
                                        <!-- Main Interactive Wrapper utilizing Button for correct Input handling -->
                                        <!-- ClipToBounds=False serves to allow Stacks to peek out -->
                                        <Button x:Name="CardButton"
                                                Command="{Binding DataContext.ToggleMapSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Click="MapCard_Click"
                                                Background="Transparent" BorderThickness="0" Padding="0"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                ClipToBounds="False"
                                                PointerEntered="MapCard_PointerEntered"
                                                PointerExited="MapCard_PointerExited">
                                            
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Panel ClipToBounds="False">
                                                        <!-- Hover Shadow Bloom -->
                                                        <Border x:Name="HoverShadow" CornerRadius="4" BoxShadow="0 15 35 0 #4D000000" Opacity="0">
                                                            <Border.Transitions>
                                                                <Transitions>
                                                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                                                                </Transitions>
                                                            </Border.Transitions>
                                                        </Border>
                                                        
                                                        <ContentPresenter Content="{TemplateBinding Content}"/>
                                                    </Panel>
                                                </ControlTemplate>
                                            </Button.Template>

                                            <Button.Styles>
                                                <Style Selector="Button:pointerover /template/ Border#HoverShadow">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </Style>
                                            </Button.Styles>
                                            
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Beatmap Info" 
                                                              Command="{Binding DataContext.OpenBeatmapUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon><PathIcon Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 12,2M11,17H13V11H11V17Z"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Open Directory" 
                                                              Command="{Binding DataContext.OpenDirectoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon><PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/></MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>

                                            <Grid>
                                                <!-- Stack Effect (Behind) -->
                                                <Border Width="180" Height="260" CornerRadius="4" Background="#E0E0E0" Opacity="0.3" IsVisible="{Binding IsStack}">
                                                    <Border.RenderTransform>
                                                        <TransformGroup><TranslateTransform Y="-16"/><RotateTransform Angle="-5"/></TransformGroup>
                                                    </Border.RenderTransform>
                                                </Border>
                                                <Border Width="180" Height="260" CornerRadius="4" Background="#E8E8E8" Opacity="0.5" IsVisible="{Binding IsStack}">
                                                    <Border.RenderTransform>
                                                        <TransformGroup><TranslateTransform Y="-8"/><RotateTransform Angle="3"/></TransformGroup>
                                                    </Border.RenderTransform>
                                                </Border>

                                                <!-- Main Card Visuals -->
                                                <!-- Moved Hover Animation here so only the top card tilts, leaving stack behind -->
                                                <!-- Main Card Visuals -->
                                                <!-- Unclipped parent so hover animation + selection glow work together -->
                                                <Border Width="180" Height="260" CornerRadius="4" ClipToBounds="False"
                                                        services:AnimationHelper.EnableHoverAnimation="True">
                                                    <Grid>
                                                        <!-- Content (Clipped for Image/Corners) -->
                                                        <Border Background="White" CornerRadius="4" ClipToBounds="True">
                                                            <Grid RowDefinitions="*,Auto">
                                                                <!-- Cover Image -->
                                                                <Border Grid.Row="0" Margin="12,12,12,0" Background="#F0F0F0" CornerRadius="2" ClipToBounds="True">
                                                                    <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="LowQuality"/>
                                                                </Border>
                                                                
                                                                <!-- Info -->
                                                                <StackPanel Grid.Row="1" Margin="12,8,12,12">
                                                                    <TextBlock Text="{Binding Title}" Foreground="#333" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Artist}" Foreground="{StaticResource AccentBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                                    <TextBlock Text="{Binding Creator, StringFormat='mapped by {0}'}" Foreground="#999" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <!-- Selection Border (Now perfectly aligned via Stretch) -->
                                                        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                                CornerRadius="4" IsHitTestVisible="False"
                                                                BoxShadow="{DynamicResource SelectionGlow}"
                                                                Opacity="{Binding IsSelected, Converter={StaticResource BoolToDoubleConverter}}">
                                                            <Border.Transitions>
                                                                <Transitions>
                                                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                                                                </Transitions>
                                                            </Border.Transitions>
                                                            <Rectangle RadiusX="4" RadiusY="4" 
                                                                       Fill="Transparent"
                                                                       Stroke="{DynamicResource AccentBrush}" 
                                                                       StrokeThickness="3" 
                                                                       StrokeDashArray="8,4"
                                                                       StrokeLineCap="Round"
                                                                       StrokeJoin="Round">
                                                                <Rectangle.Styles>
                                                                    <Style Selector="Rectangle">
                                                                        <Style.Animations>
                                                                            <Animation Duration="0:0:1" IterationCount="Infinite" Easing="LinearEasing">
                                                                                <KeyFrame Cue="0%"><Setter Property="StrokeDashOffset" Value="0"/></KeyFrame>
                                                                                <KeyFrame Cue="100%"><Setter Property="StrokeDashOffset" Value="12"/></KeyFrame>
                                                                            </Animation>
                                                                        </Style.Animations>
                                                                    </Style>
                                                                </Rectangle.Styles>
                                                            </Rectangle>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
    
                        <!-- Load More & Loading Section -->
                        <cc:LoadingFooter Grid.Row="1" IsVisible="{Binding IsSearching, Converter={StaticResource BoolNegationConverter}}"/>
                    </Grid>
                </ScrollViewer>


                <!-- Persistent Progress Bar (Visible when Queue Bar is collapsed/hidden but processing is active) -->
                <!-- Or just general progress bar at bottom of list -->
                <Border VerticalAlignment="Bottom" Margin="32,0,32,10" 
                        IsVisible="{Binding !IsBottomBarExpanded}" 
                        CornerRadius="2" ClipToBounds="True">
                    <ProgressBar Minimum="0" Maximum="100" 
                                 Value="{Binding ProgressPercentage}" 
                                 Height="4" 
                                 Foreground="{StaticResource AccentBrush}"
                                 IsVisible="{Binding IsProcessing}"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Floating Bottom Selection Bar -->
        <Border Grid.Row="1" x:Name="BottomBarBorder"
                PointerEntered="BottomBar_PointerEntered"
                PointerExited="BottomBar_PointerExited"
                IsVisible="{Binding HasSelectedMaps}"
                VerticalAlignment="Bottom"
                Margin="22"
                CornerRadius="24"
                Background="{StaticResource SurfaceElevatedBrush}"
                BoxShadow="0 10 40 0 #66000000"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Opacity="{Binding HasSelectedMaps, Converter={StaticResource BoolToDoubleConverter}, ConverterParameter='0,1'}"
                IsHitTestVisible="{Binding HasSelectedMaps}"
                Height="{Binding IsBottomBarExpanded, Converter={StaticResource BoolToDoubleConverter}, ConverterParameter='80,480'}"
                ClipToBounds="True">
            
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Height" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>



            <Grid RowDefinitions="80,*">
                <!-- Collapsed View / Header of Bar -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="24,0"
                      Background="Transparent">

                    <!-- Latest Item Info -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="16"
                                IsVisible="{Binding !IsBottomBarExpanded}">
                        <Border Width="48" Height="48" CornerRadius="8" ClipToBounds="True" Background="{StaticResource SurfaceBrush}">
                            <Image Source="{Binding LastSelectedItem.MapGroup.CoverBitmap}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                             <TextBlock Text="{Binding LastSelectedItem.DisplayName}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                             <TextBlock Text="{Binding LastSelectedItem.SubDisplayName}" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                        IsVisible="{Binding LastSelectedItem.SubDisplayName, Converter={StaticResource NullToBoolConverter}}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Selection Count Breakdown -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12"
                                IsVisible="{Binding IsBottomBarExpanded}">
                        <TextBlock Text="📊" FontSize="20" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} items selected'}" 
                                   FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Expand/Collapse Toggle Area (Clean/Transparent) -->
                    <Button Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                            Background="Transparent" BorderThickness="0" Padding="0"
                            Cursor="Hand"
                            Command="{Binding $parent[Window].DataContext.ToggleBottomBarCommand}">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </Button.Styles>
                    </Button>




                    <!-- Quick Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
                        <!-- Minimal Path View in Collapsed State -->
                        <!-- Minimal Path View - Only shown when expanded to keep collapsed view clean for "Last Song" -->
                        <Border IsVisible="{Binding IsBottomBarExpanded}" 
                                Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="12" Padding="12,8" 
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="📁" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding OutputPath}" MaxWidth="200" TextTrimming="CharacterEllipsis" 
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <Button Content="Convert to MP3" 
                                Classes="Primary" 
                                Height="48" Padding="32,0" 
                                Command="{Binding StartConversionCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Expanded Content -->
                <Grid Grid.Row="1" Margin="24,0,24,24" RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsBottomBarExpanded}">
                    <!-- Output Path Configuration -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" 
                            CornerRadius="16" Padding="20" Margin="0,0,0,20"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                         <Grid ColumnDefinitions="Auto,*,Auto">
                             <TextBlock Text="📁" FontSize="24" Foreground="{StaticResource AccentBrush}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                             <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                 <TextBlock Text="Conversion Output Path" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}"/>
                                 <TextBox Text="{Binding OutputPath}" Classes="Modern" Margin="0,4,0,0"/>
                             </StackPanel>
                             <Button Grid.Column="2" Content="Browse" Classes="Secondary" Margin="16,0,0,0" VerticalAlignment="Bottom"
                                     Command="{Binding BrowseOutputPathCommand}"/>
                         </Grid>
                    </Border>

                    <!-- Selected Items List -->
                    <ScrollViewer Grid.Row="1" Margin="0,0,0,20">
                        <ItemsControl ItemsSource="{Binding SelectedItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}" 
                                            CornerRadius="12" Padding="16,12" Margin="0,0,0,8"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                             <Grid ColumnDefinitions="40,*,Auto">
                                                 <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6" ClipToBounds="True">
                                                     <Image Source="{Binding MapGroup.CoverBitmap}" Stretch="UniformToFill"/>
                                                 </Border>
                                                 <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                                     <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"/>
                                                     <TextBlock Text="{Binding SubDisplayName}" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                                                IsVisible="{Binding SubDisplayName, Converter={StaticResource NullToBoolConverter}}"/>
                                                 </StackPanel>
                                                 
                                                 <!-- Queue Actions -->
                                                 <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                     <Button Classes="Secondary" Padding="8" Width="32" Height="32" ToolTip.Tip="Edit Metadata / Crop"
                                                             Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             CommandParameter="{Binding}">
                                                         <PathIcon Data="M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25ZM20.71,7.04C21.1,6.65 21.1,6.02 20.71,5.63L18.37,3.29C17.98,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04Z" Width="14" Height="14"/>
                                                     </Button>
                                                     <Button Classes="Secondary" Padding="8" Width="32" Height="32" ToolTip.Tip="Remove"
                                                             Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             CommandParameter="{Binding}">
                                                         <TextBlock Text="✕" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                     </Button>
                                                 </StackPanel>
                                             </Grid>
                                        </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Overall Status & Progress -->
                    <Border Grid.Row="2" IsVisible="{Binding IsProcessing}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding ProgressMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat='{}{0}%'}" FontSize="12" FontWeight="Bold"/>
                            </Grid>
                            <Border Height="8" CornerRadius="4" Background="{StaticResource SurfaceBrush}" ClipToBounds="True">
                                <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="8" Foreground="{StaticResource AccentBrush}" ShowProgressText="False"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        </Grid>

        <!-- Overlay Menu -->
        <Grid Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsOverlayOpen}" ZIndex="100">
            <!-- Dim Background -->
            <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Black" Opacity="0.7"
                    Command="{Binding CloseOverlayCommand}">
               <Button.Styles>
                   <Style Selector="Button">
                       <Setter Property="Template">
                           <ControlTemplate>
                               <Border Background="{TemplateBinding Background}"/>
                           </ControlTemplate>
                       </Setter>
                       <Setter Property="Transitions">
                           <Transitions>
                               <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                           </Transitions>
                       </Setter>
                   </Style>
               </Button.Styles>
            </Button>

            <!-- Menu Card -->
            <Border x:Name="OverlayCard" Width="900" Height="700" CornerRadius="24"
                    Background="{StaticResource SurfaceElevatedBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    BoxShadow="0 20 50 0 #66000000">
                 <Grid RowDefinitions="Auto,*,Auto" Margin="32" ClipToBounds="False">
                     <StackPanel Spacing="8">
                         <TextBlock Text="Select Difficulty" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                         <TextBlock Text="{Binding OverlayMapGroup.Artist, StringFormat='{}from {0}'}" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                     </StackPanel>

                     <ScrollViewer Grid.Row="1" Margin="0,24" ClipToBounds="False">
                         <ItemsControl ItemsSource="{Binding OverlayMapGroup.Difficulties}" ClipToBounds="False">
                             <ItemsControl.ItemsPanel>
                                 <ItemsPanelTemplate>
                                     <WrapPanel ItemWidth="200" ItemHeight="280" ClipToBounds="False">
                                         <WrapPanel.Transitions>
                                             <Transitions>
                                                 <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                                             </Transitions>
                                         </WrapPanel.Transitions>
                                     </WrapPanel>
                                 </ItemsPanelTemplate>
                             </ItemsControl.ItemsPanel>
                             <ItemsControl.ItemTemplate>
                                 <DataTemplate>
                                     <Border Width="180" Height="260" Margin="0,0,20,20" CornerRadius="4" ClipToBounds="False"
                                             services:AnimationHelper.EnableEntranceAnimation="True">

                                          <!-- Interactive Difficulty Button (Wrapped) -->
                                          <Button Command="{Binding DataContext.SelectDifficultyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"
                                                  Background="Transparent" BorderThickness="0" Padding="0"
                                                   ClipToBounds="False"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                  services:AnimationHelper.EnableHoverAnimation="True"
                                                  PointerEntered="DifficultyCard_PointerEntered"
                                                  PointerExited="DifficultyCard_PointerExited">
                                              
                                              <Button.Template>
                                                  <ControlTemplate TargetType="Button">
                                                      <Panel>
                                                          <!-- Hover Shadow -->
                                                          <Border x:Name="HoverShadow" CornerRadius="4" BoxShadow="0 10 20 0 #2E000000" Opacity="0">
                                                              <Border.Transitions>
                                                                  <Transitions>
                                                                      <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                                                  </Transitions>
                                                              </Border.Transitions>
                                                          </Border>
                                                          <ContentPresenter Content="{TemplateBinding Content}"/>
                                                      </Panel>
                                                  </ControlTemplate>
                                              </Button.Template>

                                              <Button.Styles>
                                                  <Style Selector="Button:pointerover /template/ Border#HoverShadow">
                                                      <Setter Property="Opacity" Value="1"/>
                                                  </Style>
                                              </Button.Styles>

                                               <!-- Card Content Wrapper -->
                                               <Grid ClipToBounds="False">
                                                   <!-- Main Visual (Clipped) -->
                                                   <Border Background="White" CornerRadius="4" BoxShadow="0 2 8 0 #1A000000" ClipToBounds="True">
                                                       <Grid RowDefinitions="*,Auto">
                                                           <!-- Cover Image -->
                                                           <Border Grid.Row="0" Margin="12,12,12,0" Background="#F0F0F0" ClipToBounds="True">
                                                               <Image Source="{Binding CoverBitmap}" 
                                                                       Stretch="UniformToFill"
                                                                       RenderOptions.BitmapInterpolationMode="LowQuality"/>
                                                           </Border>
           
                                                           <!-- Info Section -->
                                                           <StackPanel Grid.Row="1" Margin="12,8,12,12">
                                                               <!-- Title -->
                                                               <TextBlock Text="{Binding Title}" 
                                                                           Foreground="#222" FontWeight="SemiBold" FontSize="12" 
                                                                           TextTrimming="CharacterEllipsis"/>
                                                               <!-- Artist -->
                                                               <TextBlock Text="{Binding Artist}" 
                                                                           Foreground="{StaticResource AccentBrush}" FontSize="11" 
                                                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                               
                                                               <!-- Audio Indicator Only -->
                                                               <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Spacing="4">
                                                                   <TextBlock Text="🎵 Preview" FontSize="10" VerticalAlignment="Center" Foreground="#999" IsVisible="{Binding Difficulty.Mp3Path, Converter={StaticResource NullToBoolConverter}}"/>
                                                               </StackPanel>
                                                           </StackPanel>
                                                       </Grid>
                                                   </Border>

                                                    <!-- Selection Border (Now perfectly aligned via Stretch) -->
                                                    <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                            CornerRadius="4" IsHitTestVisible="False"
                                                            BoxShadow="{DynamicResource SelectionGlow}"
                                                            Opacity="{Binding IsSelected, Converter={StaticResource BoolToDoubleConverter}}">
                                                        <Border.Transitions>
                                                            <Transitions>
                                                                <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                                                            </Transitions>
                                                        </Border.Transitions>
                                                         <Rectangle RadiusX="4" RadiusY="4" 
                                                                    Fill="Transparent"
                                                                    Stroke="{DynamicResource AccentBrush}" 
                                                                    StrokeThickness="3" 
                                                                    StrokeDashArray="8,4"
                                                                    StrokeLineCap="Round"
                                                                    StrokeJoin="Round">
                                                             <Rectangle.Styles>
                                                                 <Style Selector="Rectangle">
                                                                     <Style.Animations>
                                                                         <Animation Duration="0:0:1" IterationCount="Infinite" Easing="LinearEasing">
                                                                             <KeyFrame Cue="0%">
                                                                                 <Setter Property="StrokeDashOffset" Value="0"/>
                                                                             </KeyFrame>
                                                                             <KeyFrame Cue="100%">
                                                                                 <Setter Property="StrokeDashOffset" Value="12"/>
                                                                             </KeyFrame>
                                                                         </Animation>
                                                                     </Style.Animations>
                                                                 </Style>
                                                             </Rectangle.Styles>
                                                         </Rectangle>
                                                    </Border>
                                               </Grid>
                                          </Button>
                                    </Border>
                                 </DataTemplate>
                             </ItemsControl.ItemTemplate>
                         </ItemsControl>
                     </ScrollViewer>

                     <Button Grid.Row="2" Content="Done" Command="{Binding CloseOverlayCommand}" Classes="Primary" HorizontalAlignment="Right" Width="120"/>
                 </Grid>
            </Border>
        </Grid>
        <!-- Unified Main Overlay (Welcome, Scanning, Audio) -->
        <Panel Grid.RowSpan="2" ZIndex="500" Name="MainOverlay" ClipToBounds="False"
               IsHitTestVisible="{Binding ShowMainOverlay}"
               Opacity="{Binding ShowMainOverlay, Converter={StaticResource BoolToDoubleConverter}}">






            <!-- Background with blur -->
            <Panel x:Name="MainOverlayBackground" Background="#0D1117" Opacity="0.95"/>
            
            <Grid>


                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="600" Margin="0,0,0,100" Spacing="40">



                     <!-- Branding -->
                     <StackPanel x:Name="BrandingStack" Spacing="24" HorizontalAlignment="Center">



                         <Border x:Name="BrandingIcon" Classes="BrandingIcon" Width="100" Height="100" Background="{StaticResource AccentBrush}" CornerRadius="24"
                                 Opacity="0" RenderTransform="scale(0.8)">
                             <Image Source="/Assets/app.ico" Width="72" Height="72" RenderOptions.BitmapInterpolationMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                         </Border>

                          <TextBlock x:Name="BrandingText" Classes="BrandingText" Text="osu!tag" FontSize="48" FontWeight="ExtraBold" HorizontalAlignment="Center"
                                     Opacity="0" RenderTransform="translateY(30px)">
                             <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Offset="0" Color="#5B9FED"/>
                                    <GradientStop Offset="1" Color="#FF66AA"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                     </StackPanel>

                        <!-- Progress / Content -->
                       <Panel x:Name="LoadingEntrance" Classes="LoadingEntrance" ClipToBounds="False"
                              Opacity="0" RenderTransform="translateY(30px)">



                         <Panel.Styles>
                             <!-- Simple style to handle the negation-to-double logic via IsVisible-like effect -->
                             <Style Selector="Panel[Opacity=0]">
                                 <Setter Property="IsHitTestVisible" Value="False"/>
                             </Style>
                             <Style Selector="Panel[Opacity=1]">
                                 <Setter Property="IsHitTestVisible" Value="True"/>
                             </Style>
                         </Panel.Styles>
                         
                         <StackPanel>
                             <!-- 1. Folder Selection / Welcome State -->
                             <Border Classes="ContentCard" Background="#1C212B" CornerRadius="24" Padding="32" BorderBrush="#30363D" BorderThickness="1" BoxShadow="0 10 40 0 #80000000"
                                     IsVisible="{Binding IsFolderSelectionVisible}">
                                 <StackPanel Spacing="24">
                                     <TextBlock Text="Welcome! Please select your Songs folder." Foreground="#AAA" FontSize="16" TextAlignment="Center" TextWrapping="Wrap"/>
                                     <Button Command="{Binding BrowseCommand}" Classes="Primary" Height="60" HorizontalAlignment="Stretch">
                                         <StackPanel Orientation="Horizontal" Spacing="12">
                                             <PathIcon Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z" Width="20" Height="20" Foreground="White" VerticalAlignment="Center"/>
                                             <TextBlock Text="Select osu! Songs Folder" FontWeight="Bold" FontSize="16"/>
                                         </StackPanel>
                                     </Button>
                                     <Button Command="{Binding UseDefaultPathCommand}" Classes="Secondary" Height="50" HorizontalAlignment="Stretch">
                                         <TextBlock Text="Use Default Path" FontWeight="Medium"/>
                                     </Button>
                                 </StackPanel>
                             </Border>

                             <!-- 2. Scanning / Processing / Audio Loading State -->
                             <Border Classes="ContentCard" Background="#1C212B" CornerRadius="24" Padding="40" BorderBrush="#30363D" BorderThickness="1" BoxShadow="0 10 40 0 #80000000"
                                     IsVisible="{Binding IsFolderSelectionVisible, Converter={StaticResource BoolNegationConverter}}">
                                 <StackPanel Spacing="32">
                                     <!-- Dynamic Title -->
                                     <TextBlock FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"
                                                Text="{Binding CurrentLoadingTitle}"/>

                                     <!-- Unified Progress Bar -->
                                     <Grid RowDefinitions="Auto,Auto">
                                         <ProgressBar Classes="SmoothLoader" Value="{Binding ProgressPercentage}" Height="10" CornerRadius="5" Foreground="{StaticResource AccentBrush}" Background="#30363D"
                                                      IsIndeterminate="{Binding IsProgressBarIndeterminate}"/>
                                         <TextBlock Grid.Row="1" Text="{Binding ProgressPercentage, StringFormat='{}{0}%'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" Margin="0,8,0,0"
                                                    IsVisible="{Binding IsProgressBarIndeterminate, Converter={StaticResource BoolNegationConverter}}"/>
                                     </Grid>

                                     <!-- Status Message -->
                                     <TextBlock FontSize="14" Foreground="#AAA" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                                IsVisible="{Binding IsLoadingMore, Converter={StaticResource BoolNegationConverter}}">
                                         <TextBlock.Text>
                                             <MultiBinding StringFormat="{}{0}">
                                                 <Binding Path="ScanStatusMessage"/>
                                                 <Binding Path="ProgressMessage"/>
                                             </MultiBinding>
                                         </TextBlock.Text>
                                     </TextBlock>

                                     <!-- Load More State (Simpler) -->
                                     <TextBlock Text="Fetching more maps from your library..." FontSize="14" Foreground="#AAA" HorizontalAlignment="Center"
                                                IsVisible="{Binding IsLoadingMore}"/>

                                 </StackPanel>
                             </Border>
                         </StackPanel>
                      </Panel>
                </StackPanel>

            </Grid>
        </Panel>



        
    </Grid>
</Window>
