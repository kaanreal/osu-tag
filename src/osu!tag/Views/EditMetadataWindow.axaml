<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Osutag.ViewModels"
        xmlns:converters="using:Osutag.Converters"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="700"
        x:Class="Osutag.Views.EditMetadataWindow"
        x:DataType="vm:EditMetadataViewModel"
        x:CompileBindings="True"
        Title="Edit Metadata"
        Width="540" Height="780"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        PointerPressed="OnPointerPressed">

    <Window.Resources>
        <converters:PathToBitmapConverter x:Key="PathToBitmapConverter"/>
        <converters:BoolToLinkedTextConverter x:Key="BoolToLinkedTextConverter"/>
        <converters:BoolToLinkedColorConverter x:Key="BoolToLinkedColorConverter"/>
    </Window.Resources>

    <Panel Background="#E6121620">
        <Grid RowDefinitions="Auto,*,Auto" Classes="WindowEntrance">

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Height="60" Background="Transparent" IsHitTestVisible="True">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Edit Metadata" HorizontalAlignment="Center" VerticalAlignment="Center" 
                               FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" Margin="20,10,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <Button Grid.Column="1" Classes="Secondary" Width="40" Height="40" VerticalAlignment="Center" Margin="0,10,10,0" Click="Cancel_Click">
                        <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Width="14" Height="14"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Border Padding="40,10,40,20">
                    <StackPanel Spacing="28">
                        
                        <!-- Title Input -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Title Override" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" FontSize="12"/>
                            <TextBox Text="{Binding OverrideTitle}" Watermark="{Binding OriginalTitle}" 
                                     Classes="Modern" Height="44"/>
                            <TextBlock Text="Default: Original metadata title" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                        </StackPanel>

                        <!-- Artist Input -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Artist Override" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" FontSize="12"/>
                            <TextBox Text="{Binding OverrideArtist}" Watermark="{Binding OriginalArtist}" 
                                     Classes="Modern" Height="44"/>
                        </StackPanel>

                        <!-- Cover Image Section -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Cover Art" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" FontSize="12"/>
                            <Grid ColumnDefinitions="160,*" Height="160">
                                 <Border Grid.Column="0" CornerRadius="12" ClipToBounds="True" Background="#000"
                                         BoxShadow="0 8 24 0 #60000000">
                                     <Image Source="{Binding ActiveCoverPath, Converter={StaticResource PathToBitmapConverter}}" Stretch="UniformToFill"/>
                                 </Border>
                                 <StackPanel Grid.Column="1" Margin="24,0,0,0" Spacing="12" VerticalAlignment="Center">
                                     <Button Content="Choose File" Classes="Secondary" HorizontalAlignment="Stretch" Click="Browse_Click" Height="40"/>
                                     <Button Content="Crop to Square" Classes="Secondary" HorizontalAlignment="Stretch" Click="Crop_Click" Height="40"/>
                                     <TextBlock Text="Recommended: 1:1 Aspect" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" TextAlignment="Center"/>
                                 </StackPanel>
                            </Grid>
                        </StackPanel>
                        
                        <!-- Rate & Pitch Section -->
                        <Border Background="#1A1F2B" CornerRadius="16" Padding="20">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Playback Speed" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PlaybackRate, StringFormat='{}{0:0.00}x'}" 
                                               FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="14"/>
                                </Grid>
                                
                                <Grid ColumnDefinitions="*,60">
                                    <Slider Grid.Column="0" Value="{Binding PlaybackRate}" Minimum="0.5" Maximum="2.0" 
                                            TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    <Button Grid.Column="1" Classes="Primary" Width="50" Height="50" CornerRadius="25" Click="PreviewRate_Click" ToolTip.Tip="Preview Audio">
                                        <PathIcon Data="M8,5.14V19.14L19,12.14L8,5.14Z" Width="22" Height="22" Foreground="White" Margin="3,0,0,0"/>
                                    </Button>
                                </Grid>
                                
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Enable Pitch" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" FontWeight="Medium"/>
                                    <ToggleButton Grid.Column="1" Classes="Secondary" Padding="24,10" VerticalAlignment="Center"
                                                 IsChecked="{Binding IsPitchShiftEnabled, Mode=TwoWay}">
                                        <TextBlock Text="Pitch" FontWeight="Bold" 
                                                   Foreground="{Binding IsPitchShiftEnabled, Converter={StaticResource BoolToLinkedColorConverter}}"/>
                                    </ToggleButton>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Bottom Actions -->
            <Border Grid.Row="2" Background="#0DFFFFFF" Padding="24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Button Grid.Column="1" Content="Cancel" Click="Cancel_Click" Classes="Secondary" Width="100" Height="44" Margin="0,0,12,0"/>
                    <Button Grid.Column="2" Content="Save Metadata" Click="Save_Click" Classes="Primary" Width="160" Height="44"/>
                </Grid>
            </Border>

        </Grid>
    </Panel>
</Window>

